#!/bin/sh
. /usr/share/libubox/jshn.sh
case "$1" in
    list) echo '{"status":{},"backup":{},"check":{},"restore":{},"reset":{}}';;
    call)
        case "$2" in
            status)
                json_init
                json_add_boolean pending "$([ -d /plugins/openwrt/.config-pending ] && echo 1 || echo 0)"
                json_dump
                exit 0
                ;;
            backup)
                umask 077
                temp=$(mktemp /tmp/rax-backup.XXXXXX) || exit 1
                output=$(rax-config backup >"$temp" 2>"$temp.error"); code=$?
                if [ "$code" = 0 ]; then
                    mv "$temp" /tmp/rax-backup.tar.gz
                else
                    output=$(cat "$temp.error")
                    rm -f "$temp"
                fi
                rm -f "$temp.error"
                ;;
            check) output=$(rax-config check /tmp/rax-config-upload.tar.gz 2>&1); code=$?;;
            restore) output=$(rax-config restore /tmp/rax-config-upload.tar.gz 2>&1); code=$?
                [ "$code" != 0 ] || rm -f /tmp/rax-config-upload.tar.gz
                ;;
            reset) output=$(rax-config reset 2>&1); code=$?;;
            *) exit 2;;
        esac
        json_init; json_add_int code "$code"; json_add_string output "$output"; json_dump
        ;;
esac
