#!/bin/sh
# Derive distinct interface addresses from this device's factory base MAC.
set -eu
base=$(sed -n 's/.*<gateway_mac value="\([0-9A-Fa-f:]*\)".*/\1/p' /usr/local/factory/sysinfo.xml | head -n 1 | tr -d :)
[ "${#base}" = 12 ] || { echo 'Factory gateway MAC unavailable' >&2; exit 1; }
value=$((0x$base + ${1:-0}))
printf '%012x\n' "$value" | sed 's/../&:/g;s/:$//'
