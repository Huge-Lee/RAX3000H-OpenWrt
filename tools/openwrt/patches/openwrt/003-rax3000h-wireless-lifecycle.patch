@@ -232,7 +232,7 @@
 	if (!wdev_script_task)
 		return run_handler_cb(wdev, cb);
 
-	wdev_script_timeout = uloop.timer(DEFAULT_SCRIPT_TIMEOUT,
+	wdev_script_timeout = uloop.timer(wdev.data.config.type == "rax3000h" ? 180000 : DEFAULT_SCRIPT_TIMEOUT,
 		() => run_handler_timeout(wdev, cb)
 	);
 }
@@ -302,8 +302,14 @@
 		return;
 
 	this.dbg("setup, state=" + this.state);
-	if (!this.autostart || this.retry_setup_failed)
-		return;
+	if (!this.autostart || this.retry_setup_failed || this.data.config.disabled)
+		return;
+
+	// This hostapd backend must tear down the old AP before replacing it.
+	if (this.state == "up" && this.data.config.type == "rax3000h") {
+		this.teardown();
+		return;
+	}
 
 	wdev_proc_reset(this);
 	delete this.config_change;
@@ -444,7 +450,10 @@
 		return;
 
 	wdev_config_init(this);
-	this.setup();
+	if (this.data.config.disabled)
+		this.teardown();
+	else
+		this.setup();
 }
 
